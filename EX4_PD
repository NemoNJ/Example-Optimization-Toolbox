ตัวอย่างที่ 4: เชื่อมกับ dynamic system (คล้าย paper)
หา kp, kd ที่ดีที่สุดสำหรับ PD controller ของระบบ 2nd order

function ITAE = simulate_and_get_ITAE(gains)
    kp = gains(1);
    kd = gains(2);
    
    ode_fun = @(t, x) [x(2); -kp*x(1) - kd*x(2)];
    
    x0 = [1; 0];
    tspan = [0, 20];
    
    [t, x] = ode45(ode_fun, tspan, x0);
    
    ITAE = trapz(t, abs(x(:,1)) .* t);
end

fun = @(gains) simulate_and_get_ITAE(gains);

x0 = [1.0, 1.0];
lb = [0.01, 0.01];
ub = [10, 10];

options = optimoptions('fmincon', 'Display', 'iter');
x_opt = fmincon(fun, x0, [], [], [], [], lb, ub, [], options);

disp(['kp optimal = ', num2str(x_opt(1))])
disp(['kd optimal = ', num2str(x_opt(2))])
