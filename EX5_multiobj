%% ===== OBJECTIVE FUNCTION =====
% Minimize: x1^2 + x2^2 + x3^2 + x4^2
fun = @(x) x(1)^2 + x(2)^2 + x(3)^2 + x(4)^2;

%% ===== INITIAL GUESS =====
x0 = [1, 2, 3, 4];  % จุดเริ่มต้น (เดาค่าแรก)

%% ===== BOUNDS (ขอบเขตของตัวแปร) =====
lb = [0, 0, 0, 0];   % ค่าต่ำสุด (x >= 0)
ub = [];              % ไม่กำหนดค่าสูงสุด

%% ===== LINEAR CONSTRAINTS (A*x <= b และ Aeq*x = beq) =====
% ไม่มี linear inequality ในตัวอย่างนี้
A   = [];  b   = [];

% Constraint 1: x1 + x2 + x3 + x4 = 10
% Constraint 4: x2 - x4 = 1
Aeq = [1,  1,  1,  1;   % constraint 1
       0,  1,  0, -1];  % constraint 4
beq = [10; 1];

%% ===== NONLINEAR CONSTRAINTS =====
% ต้องเขียนเป็น function แยก
% fmincon ต้องการรูปแบบ: c(x) <= 0  และ  ceq(x) = 0
function [c, ceq] = myConstraints(x)
    % Nonlinear INEQUALITY (c <= 0)
    c(1) = -x(1)*x(2) + 4;       % constraint 2: x1*x2 >= 4  →  -x1*x2 + 4 <= 0
    c(2) =  x(1)^2 + x(3)^2 - 20; % constraint 3: x1^2+x3^2 <= 20

    % Nonlinear EQUALITY (ceq = 0)
    ceq = [];  % ไม่มีในตัวอย่างนี้
end

%% ===== OPTIONS: ใช้ interior-point =====
options = optimoptions('fmincon', ...
    'Algorithm',  'interior-point', ...
    'Display',    'iter', ...    % แสดงผลทุก iteration
    'MaxIter',    1000, ...
    'OptimalityTolerance', 1e-8);

%% ===== รัน fmincon =====
[x_opt, fval, exitflag, output] = fmincon(fun, x0, ...
    A, b, Aeq, beq, lb, ub, @myConstraints, options);
